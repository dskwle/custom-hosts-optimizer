{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    // 单测用 node --experimental-strip-types 直接跑 TS，必须写显式 .ts 后缀；
    // 否则 tsc 报 TS5097（noEmit 已开，带不进构建产物）
    "allowImportingTsExtensions": true,
    "lib": ["ESNext"],
    "types": ["node"],
    // src/services/hosts.ts 用到了 Workers 的 cloudflare:sockets，
    // 本地分支由 server/shims 提供实现，esbuild 与 tsc 都指向同一份。
    "paths": {
      "cloudflare:sockets": ["./server/shims/cloudflare-sockets.ts"]
    }
  },
  "include": ["src/**/*", "server/**/*"],
  "exclude": ["node_modules", "dist-server", "data"]
}

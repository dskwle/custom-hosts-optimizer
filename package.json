{
  "name": "custom-hosts-optimizer",
  "version": "1.3.0",
  "private": true,
  "description": "自定义域名访问加速，智能 IP 优选解决访问慢的问题（本地 Node 运行）",
  "keywords": [
    "hosts",
    "dns",
    "ip-optimization",
    "github-hosts",
    "custom-domains"
  ],
  "homepage": "https://github.com/Yan-nian/custom-host",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yan-nian/custom-host.git"
  },
  "author": "Yan-nian",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "local": "node server/build.mjs && node dist-server/index.mjs",
    "local:dev": "node server/build.mjs && node --watch dist-server/index.mjs",
    "local:build": "node server/build.mjs",
    "local:watch": "node server/build.mjs --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "hono": "^4.6.7"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.25.4",
    "typescript": "^7.0.2"
  }
}
